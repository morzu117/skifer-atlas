<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runtime renforcé (notarisation, plan 0019). Le sidecar PyInstaller décompresse ses
     modules natifs (Python, DuckDB, connecteur Snowflake) dans un dossier temporaire, puis
     les charge : ils ne portent pas la signature de l'équipe, d'où les deux exceptions. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
